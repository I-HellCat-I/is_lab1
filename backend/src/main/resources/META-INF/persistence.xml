<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="default" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <!-- ЯВНОЕ ПЕРЕЧИСЛЕНИЕ ВСЕХ СУЩНОСТЕЙ -->
        <class>com.hellcat.movie_app.entity.Movie</class>
        <class>com.hellcat.movie_app.entity.Person</class>
        <class>com.hellcat.movie_app.entity.Coordinates</class>
        <class>com.hellcat.movie_app.entity.Location</class>
        <class>com.hellcat.movie_app.entity.ImportHistory</class>

        <!-- Это говорит, что даже если мы что-то не перечислили,
             он все равно должен попытаться найти -->
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.PostgreSQLPlatform"/>
            <!-- Мы также можем переместить свойство weaving сюда для централизации -->
            <property name="eclipselink.weaving" value="false"/>
        </properties>
    </persistence-unit>
</persistence>